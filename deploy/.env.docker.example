# THAM KHẢO — không cần chép tay.
#
# `./deploy/install.sh` tự sinh deploy/.env với khoá ngẫu nhiên. Tệp này chỉ để
# tra xem có những biến nào và mỗi biến làm gì.

# ── Ứng dụng ─────────────────────────────────────────────────────────────────
APP_NAME="Tin360s"
APP_ENV=production
APP_DEBUG=false

# BẮT BUỘC và phải giữ NGUYÊN mãi mãi: token TikTok trong cơ sở dữ liệu được mã
# hoá bằng khoá này, đổi khoá là không giải mã được nữa.
#   Sinh: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
WEB_APP_KEY=

SITE_NAME="Tin360s"

# ── Tên miền ─────────────────────────────────────────────────────────────────
DOMAIN=tin360s.vn              # website tin tức
CMS_DOMAIN=cms.tin360s.vn      # CMS dựng video
GRAFANA_DOMAIN=                # để trống thì không mở Grafana ra ngoài
ADMIN_EMAIL=ban@tin360s.vn     # Let's Encrypt gửi cảnh báo hết hạn tới đây

# ── Cơ sở dữ liệu (dùng chung cho CMS và website) ────────────────────────────
DB_CONNECTION=mysql
DB_DATABASE=showbiz_cms
DB_USERNAME=showbiz
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Phiên đăng nhập để ở MySQL, KHÔNG chuyển sang Redis: hai ứng dụng dùng chung
# bảng `sessions` để một lần đăng nhập vào được cả hai, và phiên mà mất khi
# Redis khởi động lại thì mọi người bị đá ra ngoài.
REDIS_HOST=redis
SESSION_DRIVER=database
CACHE_STORE=redis
QUEUE_CONNECTION=redis

# ── Lịch chạy ────────────────────────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
SCHEDULE_TIME=07:30            # giờ dựng video hằng ngày
RUN_ON_START=false             # true = dựng video ngay khi container lên
BACKUP_KEEP_DAYS=14            # giữ bao nhiêu ngày bản sao lưu

# Khoá để dây chuyền Python nạp dữ liệu vào CMS và website
#   Sinh: openssl rand -hex 24
INGEST_TOKEN=

GRAFANA_PASSWORD=

# ── TikTok — xem cms/docs/tiktok-setup.md (cũng sửa được trong giao diện) ────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://cms.tin360s.vn/tiktok/callback
TIKTOK_POST_MODE=inbox

# ── Đăng nhập Google — xem cms/docs/google-setup.md ──────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://cms.tin360s.vn/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=
