# Cấu hình cho bản chạy trong Docker. Chép thành deploy/.env.docker rồi sửa.
#
#   cp deploy/.env.docker.example deploy/.env.docker

APP_NAME="Showbiz CMS"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000

# BẮT BUỘC và phải giữ nguyên mãi mãi: token TikTok trong DB mã hoá bằng khoá này.
# Sinh khoá:  docker run --rm php:8.3-cli php -r 'echo "base64:".base64_encode(random_bytes(32));'
APP_KEY=

DB_CONNECTION=mysql
DB_DATABASE=showbiz_cms
DB_USERNAME=showbiz
DB_PASSWORD=đổi-mật-khẩu-này
DB_ROOT_PASSWORD=đổi-mật-khẩu-này-nữa

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Tên miền và HTTPS ────────────────────────────────────────────
# install-vps.sh tự điền các dòng này. Cài tay thì khai ở đây.
DOMAIN=localhost
ADMIN_EMAIL=ban@vidu.vn
GRAFANA_DOMAIN=
GRAFANA_PASSWORD=doi-mat-khau-nay

# ── Lịch dựng video ──────────────────────────────────────────────
TZ=Asia/Ho_Chi_Minh
SCHEDULE_TIME=07:30
RUN_ON_START=false

# Dây chuyền ghi video vào ổ đĩa dùng chung, CMS đọc từ đó
PIPELINE_ROOT=/data

# Khoá để dây chuyền nạp dữ liệu. Sinh mới:  openssl rand -hex 24
INGEST_TOKEN=

# TikTok — xem cms/docs/tiktok-setup.md (cũng sửa được trong giao diện)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/tiktok/callback
TIKTOK_POST_MODE=inbox

# Đăng nhập Google — xem cms/docs/google-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_ALLOWED_DOMAIN=
