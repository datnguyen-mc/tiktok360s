        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "showbiz_last_run_duration_seconds",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#D03B3B",
                "value": null
              },
              {
                "color": "#0CA30C",
                "value": 90
              },
              {
                "color": "#FAB219",
                "value": 120
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "justifyMode": "auto",
        "textMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
